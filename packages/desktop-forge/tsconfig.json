{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noImplicitAny": true,
    "noEmit": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "forge.env.d.ts",
    "src/main.ts",
    "src/electron/**/*.ts",
    "src/preload.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".vite"
  ]
}
