# Example macOS signing and notarization environment variables.
# Copy this file to signing.local.env and fill in local values.
# signing.local.env is ignored by git and loaded by forge.config.ts.
# Existing shell or CI environment variables take precedence.

# Required for Apple app notarization.
APPLE_ID=your-apple-developer-email@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=YOUR_TEAM_ID

# Optional: use notarization credentials stored by `xcrun notarytool store-credentials`.
# APPLE_KEYCHAIN_PROFILE=LongwiseTechAgent
# APPLE_KEYCHAIN=/Users/you/Library/Keychains/login.keychain-db

# Optional: select the Developer ID Application certificate used by @electron/osx-sign.
# If omitted, @electron/osx-sign will auto-detect a Developer ID Application identity.
# CSC_NAME=haojie chen (WXP9XWC9DE)
# CSC_KEYCHAIN=/Users/you/Library/Keychains/login.keychain-db
