# Copy this file to signing.local.env and fill in local signing values.
# signing.local.env is ignored by git.

# Required for Apple notarization.
APPLE_ID=your-apple-developer-email@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=WXP9XWCGDE

# Optional: also notarize and staple the final DMG, not just the .app.
# OPENCODE_DESKTOP_NOTARIZE_DMG=1

# Optional when signing from a .p12 instead of the macOS login keychain.
# CSC_LINK=/absolute/path/to/DeveloperIDApplication.p12
# CSC_KEY_PASSWORD=your-p12-password

# Optional when multiple Developer ID identities exist in the keychain.
# Omit the "Developer ID Application:" prefix; electron-builder adds it automatically.
# CSC_NAME=haojie chen (WXP9XWCGDE)
