{
    "name": "@opencode-ai/desktop-lxz",
    "productName": "LongwiseTechAgent",
    "version": "1.0.0",
    "description": "LongwiseTechAgent desktop client",
    "homepage": "https://opencode.ai",
    "author": {
        "name": "opencode",
        "email": "hello@opencode.ai"
    },
    "license": "MIT",
    "private": true,
    "main": "dist/main/index.cjs",
    "type": "module",
    "scripts": {
        "dev": "bun run script/dev.ts",
        "runtime:install": "bun run script/install-runtimes.ts",
        "typecheck": "tsc --noEmit && tsc -p script/tsconfig.json --noEmit",
        "build": "bun run runtime:install && electron-vite build",
        "preview": "electron-vite preview",
        "pack": "bun run script/electron-builder.ts -- --dir",
        "pack:mac": "bun run script/electron-builder.ts -- --mac --dir",
        "dist": "bun run script/electron-builder.ts",
        "dist:win": "bun run script/electron-builder.ts -- --win",
        "dist:win:zip": "bun run script/electron-builder.ts -- --win zip --x64",
        "dist:mac": "bun run script/electron-builder.ts -- --mac",
        "dist:mac:x64": "bun run script/electron-builder.ts -- --mac --x64",
        "dist:mac:arm64": "bun run script/electron-builder.ts -- --mac --arm64"
    },
    "dependencies": {
        "@opencode-ai/sdk": "workspace:*",
        "@opencode-ai/ui": "workspace:*",
        "lucide-solid": "1.14.0",
        "pdfjs-dist": "5.4.530",
        "solid-js": "^1.8.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.0.0",
        "electron": "33.0.0",
        "electron-builder": "^25.0.0",
        "electron-vite": "^3.0.0",
        "typescript": "^5.6.0",
        "vite": "^5.4.0",
        "vite-plugin-solid": "^2.10.0"
    }
}
