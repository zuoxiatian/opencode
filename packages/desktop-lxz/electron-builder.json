{
    "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
    "appId": "ai.opencode.desktop",
    "productName": "LongwiseTechAgent",
    "executableName": "LongwiseTechAgent",
    "directories": {
        "output": "release",
        "buildResources": "build"
    },
    "afterAllArtifactBuild": "./script/notarize-dmg.cjs",
    "files": [
        "dist/**/*",
        "!node_modules"
    ],
    "extraResources": [
        {
            "from": "build/icon.png",
            "to": "icon.png"
        },
        {
            "from": "build/icon.ico",
            "to": "icon.ico"
        },
        {
            "from": "skills/",
            "to": "skills/"
        },
        {
            "from": "config/opencode.jsonc",
            "to": "config/opencode.jsonc"
        }
    ],
    "win": {
        "forceCodeSigning": false,
        "extraResources": [
            {
                "from": "bin/",
                "to": "bin/",
                "filter": [
                    "opencode.exe"
                ]
            },
            {
                "from": "runtimes/win32-${arch}/",
                "to": "runtimes/win32-${arch}/"
            }
        ],
        "target": [
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "portable",
                "arch": [
                    "x64"
                ]
            }
        ],
        "icon": "build/icon.ico",
        "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "shortcutName": "LongwiseTechAgent",
        "uninstallDisplayName": "LongwiseTechAgent",
        "installerIcon": "build/icon.ico",
        "uninstallerIcon": "build/icon.ico",
        "artifactName": "${productName}-${version}-win-${arch}-Installer.${ext}"
    },
    "portable": {
        "artifactName": "${productName}-${version}-win-${arch}-Portable.${ext}"
    },
    "mac": {
        "forceCodeSigning": true,
        "hardenedRuntime": true,
        "gatekeeperAssess": false,
        "entitlements": "build/entitlements.mac.plist",
        "entitlementsInherit": "build/entitlements.mac.inherit.plist",
        "notarize": true,
        "target": [
            {
                "target": "dmg"
            },
            {
                "target": "zip"
            }
        ],
        "extraResources": [
            {
                "from": "bin/mac/${arch}/",
                "to": "bin/",
                "filter": [
                    "opencode"
                ]
            },
            {
                "from": "runtimes/darwin-${arch}/",
                "to": "runtimes/darwin-${arch}/"
            }
        ],
        "icon": "build/icon.icns",
        "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
        "category": "public.app-category.developer-tools",
        "extendInfo": {
            "CFBundleDisplayName": "LongwiseTechAgent",
            "CFBundleName": "LongwiseTechAgent"
        }
    },
    "dmg": {
        "title": "LongwiseTechAgent",
        "background": "build/background.tiff",
        "iconSize": 96,
        "window": {
            "width": 768,
            "height": 530
        },
        "contents": [
            {
                "x": 240,
                "y": 255,
                "type": "file"
            },
            {
                "x": 528,
                "y": 255,
                "type": "link",
                "path": "/Applications"
            }
        ]
    },
    "linux": {
        "target": [
            {
                "target": "AppImage",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "deb",
                "arch": [
                    "x64"
                ]
            }
        ],
        "extraResources": [
            {
                "from": "bin/linux/${arch}/",
                "to": "bin/",
                "filter": [
                    "opencode"
                ]
            },
            {
                "from": "runtimes/linux-${arch}/",
                "to": "runtimes/linux-${arch}/"
            }
        ],
        "icon": "build/icon.png",
        "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
        "category": "Development",
        "maintainer": "opencode <hello@opencode.ai>"
    }
}
